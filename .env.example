# ==============================================================================
# College Placement Management System (CPMS)
# Java Spring Boot 3 + MongoDB Backend Environment Configuration
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# MongoDB Connection (Local MongoDB or MongoDB Atlas Cloud)
# Example Local: mongodb://localhost:27017/cpms
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cpms?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/cpms

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Institution Mailer Configuration (Spring Mail)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=cpms.ac.in@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password_here
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Frontend URL for email action redirects
FRONTEND_URL=http://localhost:5173
